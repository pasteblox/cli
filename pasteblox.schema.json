{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasteblox.com/schema/pasteblox.json",
  "title": "pasteblox.json",
  "description": "Maps local Luau/Lua files to pasteblox.com scripts for the pbx CLI.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file"],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to this file, with forward slashes."
          },
          "slug": {
            "type": "string",
            "pattern": "^[23456789abcdefghjkmnpqrstuvwxyz]{10}$",
            "description": "Filled in by pbx push when the script is created."
          },
          "visibility": { "enum": ["public", "unlisted", "private"], "default": "unlisted" },
          "title": { "type": "string", "maxLength": 100 }
        }
      }
    }
  },
  "required": ["scripts"]
}
